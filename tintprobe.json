{
  "schema_version": 1,
  "default_theme": "ithilien-dawn",
  "palettes": {
    "shared": "scripts/palette/ithilien-shared.json",
    "variants": {
      "ithilien-dawn": "scripts/palette/ithilien-dawn.json"
    }
  },
  "ports": {
    "ghostty": "extras/ghostty/themes/ithilien_dawn.conf",
    "codex_theme": "extras/codex/themes/ithilien-dawn.tmTheme",
    "codex_config": "extras/codex/config.toml",
    "zsh": "extras/shell/ithilien-dawn.zsh",
    "prompt": "extras/shell/prompt.zsh"
  },
  "workflow_dir": "tests/workflows",
  "default_adapter": {
    "id": "ithilien-dawn",
    "paths": [
      ".",
      "tests/evaluation/deps/kanso"
    ],
    "setup": "require('ithilien').load('dawn')",
    "after_diff": "require('ithilien.diff').refresh()"
  },
  "contracts": {
    "ordinary_weight_diffs": true
  },
  "evaluation_dir": "tests/evaluation"
}
